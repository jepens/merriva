# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / coverage
/coverage
/test-results
/playwright-report
/playwright/.cache
/blob-report

# next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
.idea

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — JANGAN pernah commit nilai rahasia.
# `.env.example` sengaja dikecualikan agar tetap ter-commit.
.env
.env.*
!.env.example

# vercel
.vercel

# supabase (tooling lokal)
/supabase/.branches
/supabase/.temp
/supabase/.env

# sentry
.sentryclirc

# konfigurasi MCP lokal (berisi token/secret) — jangan pernah commit
.mcp.json

# handoff/ audio biner — arsip & deliverable besar (WAV master 82 MB + MP3 11 MB).
# JANGAN bloat git history: history menyimpan blob permanen. Sumber kebenaran
# runtime = Supabase storage (sudah di-seed); library bisa di-regenerate dari
# handoff/music/generator/make_music.py (yang tetap di-commit).
handoff/music/wav/
handoff/music/mp3/

# CSS tema hasil generate (scripts/build-theme-css.mjs) — dibuat ulang saat dev/build.
/public/themes/

# Laporan gitleaks di runner CI — jangan pernah ikut ter-commit.
results.sarif

# Folder keluaran perkakas (spasi di namanya, muncul di root repo). Berkas yang
# layak disimpan dipindahkan ke handoff/, bukan dibiarkan menumpuk di sini.
Claude outputs/
