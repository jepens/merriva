{
  "name": "merriva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "dev": "node scripts/build-theme-css.mjs && next dev",
    "build": "node scripts/build-theme-css.mjs && next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "demo:photos": "node scripts/fetch-demo-photos.mjs",
    "theme:new": "node scripts/new-theme.mjs",
    "thumbs": "node scripts/capture-theme-thumbs.mjs",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "loadtest": "k6 run scripts/k6/invitation-load.js",
    "typecheck": "node scripts/build-theme-css.mjs && tsc --noEmit",
    "env:check": "node scripts/check-env.mjs",
    "ops:verify": "node scripts/ops-verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "supabase": "supabase",
    "bundle:report": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "read-excel-file": "^9.3.12",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.7.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
