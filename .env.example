# =============================================================================
# Merriva — DAFTAR INDUK environment variable
#
# Berkas ini SATU-SATUNYA daftar yang perlu Anda baca. Setelah mengisi, jalankan:
#
#     pnpm env:check            # periksa berkas dev   (.env.local)
#     pnpm env:check --prod     # periksa berkas produksi (.env.production.local)
#
# Perintah itu menyebutkan persis apa yang masih kosong, apa akibatnya bila
# dibiarkan, mana yang wajib jadi build-arg, dan — penting — variabel mana yang
# diam-diam diwarisi dari berkas env lain.
#
# -----------------------------------------------------------------------------
# TIGA TEMPAT, DAN KENAPA TIDAK BISA SATU
# -----------------------------------------------------------------------------
#   1. `.env.local`              → DEV di mesin Anda. Next memprioritaskannya.
#   2. `.env.production.local`   → nilai PRODUKSI. Hanya dimuat saat
#                                  NODE_ENV=production (mis. `pnpm build && pnpm start`),
#                                  jadi `pnpm dev` tak pernah menyentuhnya.
#   3. Panel Easypanel           → yang BENAR-BENAR dipakai server produksi.
#
# Nomor 3 tak bisa digantikan berkas apa pun: `.dockerignore` membuang `.env*`
# dari konteks build, jadi tak ada berkas env yang pernah masuk ke image. Nomor 2
# ada supaya Anda punya SATU berkas untuk diisi dan disalin ke panel, dan supaya
# `pnpm env:check --prod` bisa memastikan tak ada yang terlewat sebelum Anda
# menyalinnya.
#
# JEBAKAN PRESEDENSI: Next memuat `.env` sebagai lapis TERENDAH, termasuk saat
# `pnpm dev`. Variabel yang tak ada di `.env.local` akan diambil dari `.env` —
# jadi JANGAN menaruh kredensial produksi di `.env`. Kalau `.env.local` hilang
# atau salah nama, dev akan menyambung ke produksi tanpa satu pun peringatan.
# `pnpm env:check` memperingatkan bila kedua berkas menunjuk project berbeda.
#
# -----------------------------------------------------------------------------
# 🏗️ = WAJIB juga diteruskan sebagai --build-arg di Easypanel
# -----------------------------------------------------------------------------
# Next meng-INLINE setiap NEXT_PUBLIC_* ke dalam bundel saat `next build`, bukan
# membacanya saat runtime. Mengisinya di panel SETELAH image jadi tidak
# berpengaruh sampai rebuild. Ada enam, semuanya ditandai di bawah.
#
# JANGAN pernah menulis nilai rahasia ke berkas yang di-commit. `.env`,
# `.env.local`, `.env.production.local` semuanya ter-gitignore; berkas INI
# (`.env.example`) sengaja ter-commit, jadi biarkan nilainya kosong.
# =============================================================================


# --- Aplikasi ---------------------------------------------------------------
# 🏗️ URL publik aplikasi, tanpa trailing slash.
#   dev  : http://localhost:3000   (pakai localhost, BUKAN 127.0.0.1 — Next 16
#          mem-403 Server Action lintas-origin)
#   prod : https://merriva.id
# KOSONGNYA TIDAK MENIMBULKAN GALAT (default localhost:3000) tetapi hostname yang
# sah untuk token Turnstile diturunkan dari sini — akibatnya RSVP, buku ucapan,
# konfirmasi hadiah, sesi tamu Album Momen, pendaftaran, dan reset kata sandi
# semuanya ditolak, dengan pesan yang MENYESATKAN (RSVP berbunyi "terlalu banyak
# percobaan"; reset kata sandi menjawab sukses palsu).
NEXT_PUBLIC_APP_URL=


# --- Supabase ---------------------------------------------------------------
# Dari Supabase Dashboard > Project Settings > API.
#   dev  : stack lokal `supabase start` → http://127.0.0.1:54321
#   prod : https://<PROJECT_REF>.supabase.co
# 🏗️ URL & anon key aman diekspos ke browser (dilindungi RLS).
# Keduanya WAJIB tersedia SAAT BUILD: pra-render statis `/`, `/harga`, `/tema`
# membaca DB dan `throw` bila gagal → project kosong ATAU di-pause = build MERAH.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — server saja, mem-BYPASS RLS. Variabel paling kritis di berkas ini:
# halaman undangan publik `/[slug]` dirender lewat klien service_role, jadi tanpa
# kunci ini SETIAP undangan 500 untuk SEMUA tamu — bukan hanya webhook/cron/admin.
# Probe LENGKAP `/api/health` (UptimeRobot/`ops:verify`) ikut 503, tetapi kontainer
# TETAP sehat: HEALTHCHECK memakai liveness `?probe=live` tanpa DB (DECISIONS #110),
# jadi tak ada restart loop yang memberi tanda — undangan 500 sementara Easypanel hijau.
SUPABASE_SERVICE_ROLE_KEY=


# --- Storage media ----------------------------------------------------------
# `supabase` (fase awal), `local` (disk VPS), atau `r2`. Kosong = `supabase`.
# Ejaan yang tak dikenali kini GAGAL-KERAS — dulu ia jatuh diam-diam ke Supabase,
# yang berarti foto tersimpan di tempat lain daripada tempat yang disajikan.
STORAGE_DRIVER=supabase
# Hanya untuk `local`: akar penyimpanan, RELATIF ke cwd proses (`/app` di
# container) → default `data/media` = `/app/data/media`. Boleh dikosongkan.
# WAJIB menunjuk VOLUME yang di-mount (Easypanel → Mounts), kalau tidak unggah
# tetap "berhasil" ke lapisan container yang dibuang tiap deploy.
MEDIA_ROOT=
# 🏗️ Basis URL penyaji media, tanpa trailing slash. Path di DB disimpan RELATIF
# (`inv/<id>/<mediaId>/1600.webp`) lalu digabung ke basis ini.
#   dev lokal : http://127.0.0.1:54321/storage/v1/object/public/media
#   dev `local`: http://localhost:3000/media
#   prod local: https://merriva.id/media   (route penyaji di app ini)
#   prod R2   : https://cdn.merriva.id
#   prod Supabase: domain proxy sendiri (SPEC §6.4 melarang serve dari URL vendor)
# GAGAL-KERAS di runtime produksi bila kosong: setiap undangan berfoto/bermusik
# → 500. SENGAJA tidak dicek saat build (CI tetap hijau), tetapi liveness
# `/api/health?probe=live` menolaknya sejak kontainer start (`media-env-invalid`)
# → HEALTHCHECK gagal → Swarm membunuh kontainer (DECISIONS #110). Untuk driver `supabase`,
# bucket `media` harus PUBLIC; untuk `local`, penyajinya route /media di app ini.
NEXT_PUBLIC_MEDIA_URL=


# --- Pembayaran — Pakasir (app.pakasir.com) ---------------------------------
# Dari dashboard Pakasir > project. Pakai project SANDBOX untuk dev.
# Slug kosong → tombol bayar mati. api_key kosong → tombol bayar JUGA mati (v2
# `create-transaction` menuntut header `X-Api-Key`), dan verifikasi otoritatif
# `transaction-status` mati, sehingga webhook dan cron TAK PERNAH bisa
# mengaktifkan order yang sudah lunas.
# Webhook URL yang harus didaftarkan di dashboard: /api/webhooks/pakasir
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
# Secret webhook (API v2). Dilihat & di-reset di BAGIAN BAWAH halaman detail
# project Pakasir. Dikirim Pakasir sebagai header `X-Secret` pada setiap webhook.
# Kosongnya tidak menolak webhook (menolak akan mematikan seluruh aktivasi bila
# belum disalin saat deploy) tetapi dilaporkan ke Sentry — jangan biarkan kosong.
PAKASIR_WEBHOOK_SECRET=


# --- Pembayaran — BinderPay (SNAP, QRIS) ------------------------------------
# Menggantikan Pakasir yang tutup (DECISIONS #99). BinderPay TERPILIH begitu
# BINDERPAY_PARTNER_ID terisi; selama kosong, checkout masih lewat Pakasir
# (masa peralihan). Driver: `src/lib/payment/binderpay.ts`; callback:
# https://merriva.id/api/webhooks/binderpay (URL Callback di proyek BinderPay).
#
# Dari dashboard BinderPay. Pakai kredensial SANDBOX untuk dev — host sandbox
# DITOLAK bila NODE_ENV=production.
BINDERPAY_PARTNER_ID=
# Base URL API, TANPA garis miring akhir. Keduanya dibaca dari SDK resmi
# mereka (25 Okt 2026):
#   sandbox  https://api-sandbox.binderpay.id
#   produksi https://api.binderpay.id
# Salah host adalah cara termahal menemukan bahwa kredensialnya benar.
BINDERPAY_BASE_URL=
# Kunci PRIVAT kita (penandatangan), PEM ter-base64 satu baris:
#     base64 -w0 binderpay-sandbox.pem
# Base64, BUKAN path berkas: ia harus bisa ditempel apa adanya ke panel
# Easypanel, dan PEM mentah mengandung baris-baru yang tak selamat melewati
# kolom env. Cara yang sama di dev maupun produksi — tetapi produksi memakai
# pasangan kunci SENDIRI, terpisah dari sandbox (DECISIONS #102).
BINDERPAY_PRIVATE_KEY_B64=
# Kunci PUBLIK BinderPay (pemverifikasi callback), base64 dengan cara yang sama.
# Disimpan sebagai env, bukan dipatok di kode, supaya rotasi kunci di sisi
# mereka tidak menuntut rilis dari kita.
# CATATAN KEAMANAN: kunci publik produksi mereka per 25 Okt 2026 berukuran
# 1023 bit (diperiksa `openssl rsa -pubin -text -noout`) — di bawah ambang yang
# layak. Itu alasan tersendiri untuk TIDAK menggantungkan aktivasi pada tanda
# tangan callback saja; aktivasi tetap menunggu cek status otoritatif.
BINDERPAY_PUBLIC_KEY_B64=


# --- Email — Resend ---------------------------------------------------------
# Kosong = SELURUH email no-op tanpa satu pun galat: kuitansi, pengingat H-14,
# notis kedaluwarsa, peringatan pra-purge H-30/H-7, penangguhan, dan
# pencabutannya. Aman untuk dev/CI, fatal di produksi tanpa gejala.
RESEND_API_KEY=
# Alamat pengirim; domainnya WAJIB terverifikasi di Resend, kalau tidak SEMUA
# kiriman ditolak 403. Default bila kosong: `Merriva <noreply@merriva.id>`.
# Kunci yang sama juga menjadi password Custom SMTP Supabase Auth — pertimbangkan
# DUA API key terpisah pada satu domain agar lonjakan cron tak bisa mematikan
# pendaftaran pelanggan.
EMAIL_FROM=


# --- Anti-spam — Cloudflare Turnstile ---------------------------------------
# 🏗️ site key boleh publik; secret RAHASIA (server).
# Untuk DEV, Cloudflare menyediakan kunci uji resmi yang selalu lolos:
#   site   = 1x00000000000000000000AA
#   secret = 1x0000000000000000000000000000000AA
# Mengosongkan KEDUANYA juga sah di dev (verifikasi dilewati, ada peringatan di
# log). Yang TIDAK boleh: secret berisi nilai acak/ngawur — Cloudflare akan
# menolaknya dan setiap form gagal.
# Di PRODUKSI secret kosong = GAGAL-TUTUP total: semua form ditolak, satu
# console.error per permintaan, NOL event Sentry.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- Album Momen (add-on kamera tamu) ---------------------------------------
# Rahasia HMAC cookie SESI TAMU `/[slug]/momen`. Buat: openssl rand -hex 32
# Melempar di produksi bila kosong, tetapi LAZILY: aplikasi start normal dan
# semua halaman jalan — yang 500 hanya halaman kamera tamu, pada saat tamu di
# acara sedang memegang HP mencoba mengunggah foto.
MOMEN_SESSION_SECRET=


# --- Cron (crontab root di host VPS — LAUNCH-CHECKLIST Fase 3) ---------------
# Gerbang fail-closed untuk KELIMA endpoint /api/cron/* (4 cron + laporan
# backup-media; keduanya membaca /etc/merriva-cron.conf di VPS), dikirim sebagai header
# `Authorization: Bearer <CRON_SECRET>`. Buat: openssl rand -hex 32
# Mengganti nilainya tanpa memasang ulang crontab host (`scripts/pasang-cron-host.sh`,
# yang menulis `/etc/merriva-cron.conf` di VPS) membuat
# semuanya dijawab 401 TANPA satu pun galat terlihat: rekonsiliasi pembayaran DAN
# retensi UU PDP berhenti diam-diam. Jangan sampai ada newline tersisip.
# Kadens yang benar ada di LAUNCH-CHECKLIST Fase 3 (dua job 12 jam, bukan harian).
CRON_SECRET=


# --- Monitoring — Sentry ----------------------------------------------------
# 🏗️ DSN boleh publik. Kosong = Sentry non-aktif — dan karena itu kegagalan
# Custom SMTP yang sengaja senyap di sisi pengguna (reset kata sandi selalu
# menjawab sukses generik demi anti-enumerasi) menjadi tak terlihat sama sekali.
# ISI SEBELUM menyentuh Custom SMTP, dan ingat ia build-arg.
NEXT_PUBLIC_SENTRY_DSN=
# Ketiga ini dibaca saat BUILD untuk unggah sourcemap. Tanpa mereka isu tetap
# masuk Sentry, hanya dengan stack frame terminifikasi.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Cloudflare R2 (hanya bila STORAGE_DRIVER=r2) ---------------------------
# Dibaca LAZILY dan hanya pada upload/hapus — jadi R2 yang salah-konfigurasi
# TIDAK mematikan pembacaan media: halaman undangan tetap tampil dan foto tetap
# muncul (URL dibangun dari NEXT_PUBLIC_MEDIA_URL). Yang mati hanya unggah foto
# di editor, unggah lagu admin, dan unggah foto Album Momen.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# =============================================================================
# DI BAWAH INI TOOLING SAJA — aplikasi runtime TIDAK PERNAH membacanya.
# Tidak perlu diisi di server produksi.
# =============================================================================

# --- Foto demo tema — Pexels ------------------------------------------------
# Hanya dipakai `pnpm demo:photos` untuk mengunduh foto contoh tema ke
# /public/demo/. Kunci gratis: https://www.pexels.com/api/
PEXELS_API_KEY=

# --- E2E — Playwright -------------------------------------------------------
# Test di-SKIP bila tak lengkap. PAKASIR_* di atas harus mengarah ke project
# SANDBOX Pakasir.
#   E2E_EMAIL / E2E_PASSWORD  : akun terverifikasi di DB target, ber-peran
#     `client` (admin/Pro tak pernah ditagih — DECISIONS #100).
#   E2E_INVITATION_ID         : undangan draft/expired (slug ASLI + minimal 1 sesi
#     jadwal berjam — syarat bayar, DECISIONS #44) untuk test poll.
#   E2E_INVITATION_ID_WEBHOOK : undangan draft TERPISAH (syarat sama) untuk test
#     webhook, agar tak bentrok. Reset ke draft tiap run.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_INVITATION_ID=
# E2E_INVITATION_ID_WEBHOOK=
