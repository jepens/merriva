# =============================================================================
# Merriva — contoh environment variables
# =============================================================================
# Cara pakai:
#   - Lokal   : salin file ini menjadi `.env.local` lalu isi nilainya.
#   - Production: isi nilai di panel Easypanel (JANGAN commit nilai asli).
#
# ATURAN: file `.env.example` ini BOLEH di-commit (tanpa nilai rahasia).
# File `.env`, `.env.local`, dsb. WAJIB masuk .gitignore — jangan pernah
# menaruh nilai rahasia di file yang di-commit.
# =============================================================================


# --- Aplikasi ---------------------------------------------------------------
# URL publik aplikasi (tanpa trailing slash). Lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Supabase (runtime aplikasi) --------------------------------------------
# Dari Supabase Dashboard > Project Settings > API.
# URL & anon key aman diekspos ke browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya dipakai di server (service role bypass RLS). JANGAN di-expose.
SUPABASE_SERVICE_ROLE_KEY=


# --- Supabase CLI / migrasi (tooling, bukan runtime app) --------------------
# Dipakai oleh perintah `pnpm supabase ...` untuk link & push migrasi.
# Tidak dibaca oleh aplikasi Next.js.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=


# --- Storage media ----------------------------------------------------------
# Driver aktif: `supabase` (fase dev/klien awal) atau `r2` (menjelang launch).
STORAGE_DRIVER=supabase
# Domain publik penyaji media (mis. https://cdn.merriva.id). Selama fase
# Supabase boleh dikosongkan / diarahkan ke route proxy sendiri.
NEXT_PUBLIC_MEDIA_URL=


# --- Pembayaran — Pakasir (app.pakasir.com) ---------------------------------
# Dari dashboard Pakasir > project. api_key RAHASIA — hanya di server.
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=


# --- Email — Resend ---------------------------------------------------------
RESEND_API_KEY=


# --- Anti-spam — Cloudflare Turnstile ---------------------------------------
# site key boleh publik (NEXT_PUBLIC_*), secret key RAHASIA (server).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- Cron (scheduled job Easypanel) -----------------------------------------
# Secret pembatas akses endpoint /api/cron/* (dikirim sebagai header).
CRON_SECRET=


# --- Monitoring — Sentry ----------------------------------------------------
# DSN boleh publik. Auth token hanya dipakai saat build untuk upload sourcemap.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Cloudflare R2 (diisi hanya saat STORAGE_DRIVER=r2, mulai M4) ------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
