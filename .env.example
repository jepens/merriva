# =============================================================================
# Merriva — contoh environment variables

# --- Aplikasi ---------------------------------------------------------------
# URL publik aplikasi (tanpa trailing slash). Lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Supabase (runtime aplikasi) --------------------------------------------
# Dari Supabase Dashboard > Project Settings > API.
# URL & anon key aman diekspos ke browser (NEXT_PUBLIC_*).
# PENTING: semua NEXT_PUBLIC_* di-INLINE saat `pnpm build` (bukan runtime) →
# WAJIB tersedia saat build. Di Docker/Easypanel diteruskan sebagai build-arg
# (lihat stage builder di Dockerfile). URL & anon key juga dipakai pra-render
# statis halaman marketing → Supabase harus terjangkau saat build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya dipakai di server (service role bypass RLS). JANGAN di-expose.
SUPABASE_SERVICE_ROLE_KEY=





# --- Storage media ----------------------------------------------------------
# Driver aktif: `supabase` (fase dev/klien awal) atau `r2` (menjelang launch).
STORAGE_DRIVER=supabase
# Basis URL publik penyaji media (tanpa trailing slash). Path media disimpan
# relatif di DB (mis. `inv/<id>/<mediaId>/1600.webp`) & digabung ke basis ini.
# - Dev (bucket Supabase publik):
#     https://<PROJECT_REF>.supabase.co/storage/v1/object/public/media
# - Dev LOKAL (`supabase start`, bucket `media` publik):
#     http://127.0.0.1:54321/storage/v1/object/public/media
# - Production: domain sendiri (CNAME ke storage/R2), mis. https://cdn.merriva.id
#   — SPEC §6.4: media disajikan dari domain sendiri, bukan URL vendor.
NEXT_PUBLIC_MEDIA_URL=


# --- Pembayaran — Pakasir (app.pakasir.com) ---------------------------------
# Dari dashboard Pakasir > project. api_key RAHASIA — hanya di server.
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=


# --- Email — Resend ---------------------------------------------------------
# Kosong = email transaksional (kuitansi, pengingat H-14) di-skip (dev/CI aman).
RESEND_API_KEY=
# Alamat pengirim; domain WAJIB terverifikasi di Resend. Default: Merriva <noreply@merriva.id>
EMAIL_FROM=


# --- Anti-spam — Cloudflare Turnstile ---------------------------------------
# site key boleh publik (NEXT_PUBLIC_*), secret key RAHASIA (server).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Album Momen (add-on kamera tamu, FASE H) -------------------------------
# Rahasia HMAC penanda-tangan cookie SESI TAMU (/[slug]/momen). Mengikat
# device+nama tamu setelah Turnstile lolos → identitas unggah tak bisa dipalsukan.
# WAJIB di produksi (server GAGAL-KERAS bila kosong). Buat dgn: openssl rand -hex 32
MOMEN_SESSION_SECRET=


# --- Cron (scheduled job Easypanel) -----------------------------------------
# Secret pembatas akses endpoint /api/cron/* — dikirim sebagai header
# `Authorization: Bearer <CRON_SECRET>`. Endpoint (POST): /api/cron/expire-orders
# (rekonsiliasi + batalkan order pending >24 jam), /api/cron/expire-invitations
# (set expired undangan lewat active_until), /api/cron/expiry-reminders
# (email pengingat H-14, M3.5), /api/cron/purge-expired (hapus permanen data
# pribadi 6 bulan pasca-expired — retensi UU PDP). Kosong = endpoint cron tertutup.
CRON_SECRET=


# --- Monitoring — Sentry ----------------------------------------------------
# DSN boleh publik. Auth token hanya dipakai saat build untuk upload sourcemap.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Foto demo tema — Pexels (tooling author-time, BUKAN runtime app) --------
# Dipakai HANYA oleh `pnpm demo:photos` untuk mencari & mengunduh foto contoh
# tema ke /public/demo/ (disajikan dari domain sendiri). App runtime TIDAK pernah
# membaca kunci ini. Kunci gratis: https://www.pexels.com/api/
PEXELS_API_KEY=


# --- E2E — Playwright (tooling test, opsional) ------------------------------
# Dipakai `tests/e2e/payment-simulation.spec.ts` (jalur poll) &
# `tests/e2e/payment-webhook.spec.ts` (jalur webhook). Test di-SKIP bila tak
# lengkap. PAKASIR_* di atas harus mengarah ke project SANDBOX Pakasir.
#   E2E_EMAIL / E2E_PASSWORD  : akun terverifikasi di DB target.
#   E2E_INVITATION_ID         : undangan draft/expired (slug ASLI) untuk test poll.
#   E2E_INVITATION_ID_WEBHOOK : undangan draft TERPISAH untuk test webhook (agar
#     tak bentrok — tiap test mengaktifkan undangannya). Reset ke draft tiap run.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_INVITATION_ID=
# E2E_INVITATION_ID_WEBHOOK=


# --- Cloudflare R2 (diisi hanya saat STORAGE_DRIVER=r2, mulai M4) ------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
