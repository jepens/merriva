{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Kode setelah `return`/`throw` menjadi GALAT, bukan sekadar saran abu-abu
    // di editor. Tanpa ini tak ada apa pun di gerbang yang melihatnya: tsc
    // memperlakukannya sebagai suggestion, dan `no-unreachable` milik ESLint
    // DIMATIKAN typescript-eslint untuk berkas TS justru dengan alasan "tsc
    // yang menangani". Lubang di antara dua asumsi itu memakan korban nyata
    // pada 17 Okt 2026 — lihat komentar di `eslint.config.mjs`.
    "allowUnreachableCode": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
